                  >
                    <Send size={14} />
                    <span>{isSubmitting ? 'Enviando...' : 'Enviar Consulta a Taller'}</span>
                  </button>
                </form>
              )}
            </div>
          </div>
        </div>
      </motion.div>
    </div>
  );
};
