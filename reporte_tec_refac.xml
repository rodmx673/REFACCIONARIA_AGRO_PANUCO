                  <div>
                    <label className="block text-[11px] font-bold text-gray-700 mb-1">¿Qué refacción estás buscando? *</label>
                    <textarea
                      required
                      rows={3}
                      placeholder="Describe la pieza, falla del tractor o número de parte que necesitas..."
                      value={message}
