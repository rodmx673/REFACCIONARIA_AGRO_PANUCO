      const docs: InvoiceHistoryRecord[] = [];
      snapshot.forEach((d) => {
        docs.push({ id: d.id, ...(d.data() as Omit<InvoiceHistoryRecord, 'id'>) });
      });
      setInvoices(docs);
      setLoading(false);

