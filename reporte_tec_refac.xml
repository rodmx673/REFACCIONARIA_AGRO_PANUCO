  const canProceedStep2 = pickupInStore || (street.trim().length >= 3 && number.trim().length >= 1 && colony.trim().length >= 2 && zipCode.trim().length === 5);

  const handleNextStep = () => {
    if (step === 1 && !canProceedStep1) {
