    // Attendance records
    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // Payroll records
    match /payroll/{payrollId} {
      allow read, write: if true;
    }

    // Invoices & SAT
    match /invoices/{invoiceId} {
