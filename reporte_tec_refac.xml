        zipCode: pickupInStore ? '76000' : zipCode.trim(),
        references: references.trim(),
        rfc: wantsInvoice ? customerRfc.trim().toUpperCase() : undefined
      };

      const orderData: Order = {
        id: '',
        orderNumber,
        customerName: customerName.trim(),
        customerEmail: customerEmail.trim().toLowerCase(),
        customerPhone: customerPhone.trim(),
        items: cart.map(item => ({
          productId: item.product.id,
          pieceNumber: item.product.pieceNumber,
          description: item.product.description,
          brand: item.product.brand,
          quantity: item.quantity,
          unitPrice: item.product.salePrice,
          subtotal: item.product.salePrice * item.quantity,
          imageUrl: item.product.imageUrl
        })),
        subtotal,
        tax,
        shippingCost: pickupInStore ? 0 : shippingCost,
        discount: discountAmount,
        total: subtotal - discountAmount + tax + (pickupInStore ? 0 : shippingCost),
        status: 'CONFIRMED',
        paymentMethod,
        paymentStatus: paymentMethod === 'TARJETA' || paymentMethod === 'PAYPAL' ? 'PAID' : 'PENDING',
        shippingAddress: shippingAddressData,
        shippingMethod: pickupInStore ? 'RECOGER_TIENDA' : shippingMethod,
        trackingNumber: `FEDEX-${Math.floor(100000000 + Math.random() * 900000000)}`,
        carrier: pickupInStore ? 'Entrega en Mostrador' : 'FedEx Express Nacional',
        couponCode: appliedCoupon?.code,
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString()
      };

      // 1. Save order in Firestore 'orders'
      const orderRef = await addDoc(collection(db, 'orders'), orderData);
      orderData.id = orderRef.id;

      // 2. Decrement stock atomically and record inventory movements
      for (const item of cart) {
        try {
          const productDoc = doc(db, 'products', item.product.id);
          await updateDoc(productDoc, {
            stock: increment(-item.quantity)
          });

          // Record movement in inventoryMovements
          await addDoc(collection(db, 'inventoryMovements'), {
            productId: item.product.id,
            type: 'OUT',
            quantity: item.quantity,
            reason: `Venta Tienda Online Pedido ${orderNumber}`,
            timestamp: new Date().toISOString(),
            userId: 'ecommerce-client'
          });
        } catch (e) {
          console.warn(`Could not adjust stock for item ${item.product.pieceNumber}:`, e);
        }
      }

      // 3. Record in 'sales' for ERP synchronization
      try {
        await addDoc(collection(db, 'sales'), {
          customerId: customerEmail.trim().toLowerCase(),
          items: orderData.items,
          subtotal: orderData.subtotal,
          discount: orderData.discount,
          tax: orderData.tax,
          total: orderData.total,
          paymentMethod: paymentMethod === 'TARJETA' ? 'TARJETA' : paymentMethod === 'CREDITO_FARMER' ? 'CRÉDITO' : 'TRANSFERENCIA',
          status: 'COMPLETED',
          timestamp: new Date().toISOString(),
          sellerId: 'tienda_online',
          orderNumber
        });
      } catch (e) {
        console.warn('Could not register in sales collection:', e);
      }

